# Copy to .env or export in your shell
HF_TOKEN=
XAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Phone API (companion/phone_api.py) — all optional, these are the defaults.
# The xAI key can also live in .vesper/xai.key (gitignored) instead of env.
VESPER_PHONE_BACKEND=ollama
VESPER_PHONE_MODEL=gemma3
VESPER_OLLAMA_URL=http://127.0.0.1:11434/v1
VESPER_PHONE_HOST=0.0.0.0
VESPER_PHONE_PORT=7861
VESPER_TTS_VOICE=ara
